# Server-only configuration (never use NEXT_PUBLIC_ for secrets)
BACKEND_API_URL=http://localhost:3001
INTERNAL_API_KEY=replace-with-identical-random-secret-used-in-backend
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-argon2id-hash
SESSION_SECRET=replace-with-random-secret-of-at-least-32-characters
UPSTASH_REDIS_REST_URL=replace-with-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# Public URL for product images hosted on the backend
NEXT_PUBLIC_ASSETS_BASE_URL=http://localhost:3001
